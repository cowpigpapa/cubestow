{
  "name": "cubestow",
  "version": "1.1.84",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "build": "node build.mjs",
    "benchmark": "node benchmark.mjs",
    "benchmark:write": "node benchmark.mjs --write && node scenario-benchmark.mjs --write",
    "benchmark:scenarios": "node scenario-benchmark.mjs",
    "test": "node --test test/*.test.mjs",
    "test:quick": "node --test --test-skip-pattern=@slow test/*.test.mjs",
    "test:e2e": "playwright test",
    "samples:capture": "node tools/capture-sample-results.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.9"
  }
}
